{
  "compilerOptions": {
    "target": "es2022",
    "outDir": "dist",
    "module": "commonjs",
    "noEmit": true,
    "types": ["node", "jest"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "strictNullChecks": true
  },
  "include": ["src/**/*", "tests/**/*", "prisma/generated/**/*"]
}
