generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  completed
  cancelled
}

enum CancelReason {
  idle
  customer
}

enum PickupMode {
  counter
  self
}

model Category {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  slug      String   @unique
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  price       Int
  imageUrl    String?  @map("image_url")
  pickupMode  PickupMode @default(counter) @map("pickup_mode")
  position    Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  inventory Inventory?
  orderItems OrderItem[]

  @@index([categoryId, position])
  @@map("products")
}

model Inventory {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId String   @unique @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("inventories")
}

model Order {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  status         OrderStatus  @default(pending)
  cancelReason   CancelReason? @map("cancel_reason")
  customerName   String       @map("customer_name")
  customerEmail  String       @map("customer_email")
  total          Int
  idempotencyKey String?      @unique @map("idempotency_key")
  paidAt         DateTime?    @map("paid_at")
  cardLast4      String?      @map("card_last4")
  pickupCode     String?      @unique @map("pickup_code")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")

  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Int     @map("unit_price")
  pickupMode PickupMode @default(counter) @map("pickup_mode")

  @@index([orderId])
  @@map("order_items")
}
